{
  "name": "1ststep-os-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "1stStep OS Audit & Recovery — deterministic audit engine and CLI",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "osaudit": "engine/src/cli.ts"
  },
  "scripts": {
    "osaudit": "node engine/src/cli.ts",
    "audit:free": "node engine/src/free-cli.ts",
    "check:free-cost": "node engine/src/free-cli.ts --check-cost",
    "test": "node --test \"engine/test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run check:free-cost"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "5.9.3"
  }
}
