{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1ststep.ai/os-audit/schemas/0.1.0/recovery-plan.schema.json",
  "title": "RecoveryPlan",
  "description": "Dependency-ordered remediation plan derived from a finalized baseline, plus the handoff package for the 1stStep OS generator. Preserves baseline vs current delta without rewriting either.",
  "type": "object",
  "required": ["kind", "schemaVersion", "id", "targetId", "baselineId", "baselineRunId", "createdAt", "status", "taskIds", "executionOrder", "priorities", "delta", "projectOsHandoff", "unresolved"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "RecoveryPlan" },
    "schemaVersion": { "$ref": "audit-common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "audit-common.schema.json#/$defs/planId" },
    "targetId": { "$ref": "audit-common.schema.json#/$defs/targetId" },
    "baselineId": { "$ref": "audit-common.schema.json#/$defs/baselineId" },
    "baselineRunId": { "$ref": "audit-common.schema.json#/$defs/runId" },
    "currentRunId": { "$ref": "audit-common.schema.json#/$defs/runId" },
    "createdAt": { "$ref": "audit-common.schema.json#/$defs/timestamp" },
    "status": { "enum": ["DRAFT", "APPROVED", "IN_PROGRESS", "COMPLETED", "SUPERSEDED"] },
    "approvedBy": { "$ref": "audit-common.schema.json#/$defs/userActor" },
    "taskIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "audit-common.schema.json#/$defs/taskId" } },
    "executionOrder": { "type": "array", "uniqueItems": true, "items": { "$ref": "audit-common.schema.json#/$defs/taskId" }, "description": "Topological order; ties broken per REMEDIATION_PRIORITIES.md." },
    "priorities": {
      "type": "object", "required": ["P0", "P1", "P2"],
      "properties": {
        "P0": { "type": "array", "items": { "$ref": "audit-common.schema.json#/$defs/taskId" } },
        "P1": { "type": "array", "items": { "$ref": "audit-common.schema.json#/$defs/taskId" } },
        "P2": { "type": "array", "items": { "$ref": "audit-common.schema.json#/$defs/taskId" } }
      },
      "additionalProperties": false
    },
    "delta": {
      "type": "object",
      "required": ["comparable"],
      "properties": {
        "comparable": { "type": "boolean", "description": "false unless both runs used identical registry/scoring/profile versions." },
        "reason": { "type": "string", "maxLength": 500 },
        "baselineScore": { "$ref": "audit-common.schema.json#/$defs/scoreValue" },
        "currentScore": { "$ref": "audit-common.schema.json#/$defs/scoreValue" },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object", "required": ["domain", "baseline", "current"],
            "properties": {
              "domain": { "$ref": "audit-common.schema.json#/$defs/domain" },
              "baseline": { "oneOf": [{ "$ref": "audit-common.schema.json#/$defs/scoreValue" }, { "type": "null" }] },
              "current": { "oneOf": [{ "$ref": "audit-common.schema.json#/$defs/scoreValue" }, { "type": "null" }] }
            },
            "additionalProperties": false
          }
        },
        "findingStatusCounts": {
          "type": "object",
          "propertyNames": { "$ref": "audit-common.schema.json#/$defs/findingStatus" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "projectOsHandoff": {
      "type": "object",
      "required": ["upstreamSchemaVersion", "profileDraftPath", "capabilityGaps", "requestedModules", "targetFiles", "generatorStatus"],
      "properties": {
        "upstreamSchemaVersion": { "$ref": "audit-common.schema.json#/$defs/semver" },
        "profileDraftPath": { "$ref": "audit-common.schema.json#/$defs/relativePath", "description": "Upstream ProjectProfile (lifecycleStage EXISTING_RECOVERY) validated against the pinned upstream schema." },
        "capabilityGaps": {
          "type": "array",
          "items": {
            "type": "object", "required": ["capabilityRef", "findingIds", "controlIds"],
            "properties": {
              "capabilityRef": { "$ref": "audit-common.schema.json#/$defs/capabilityRef" },
              "findingIds": { "type": "array", "minItems": 1, "items": { "$ref": "audit-common.schema.json#/$defs/findingId" } },
              "controlIds": { "type": "array", "minItems": 1, "items": { "$ref": "audit-common.schema.json#/$defs/controlId" } }
            },
            "additionalProperties": false
          }
        },
        "requestedModules": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,48}$" }, "description": "Upstream module ids. Empty until upstream module registry exists." },
        "targetFiles": { "type": "array", "uniqueItems": true, "items": { "$ref": "audit-common.schema.json#/$defs/relativePath" } },
        "generatorStatus": { "enum": ["NOT_SENT", "SENT", "GENERATED", "APPLIED_BY_USER", "REJECTED"] }
      },
      "additionalProperties": false
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "question", "blocking"],
        "properties": {
          "id": { "type": "string", "pattern": "^DEC-[0-9]{3,}$" },
          "question": { "type": "string", "maxLength": 1000 },
          "blocking": { "type": "boolean" },
          "findingIds": { "type": "array", "items": { "$ref": "audit-common.schema.json#/$defs/findingId" } }
        },
        "additionalProperties": false
      }
    }
  }
}
