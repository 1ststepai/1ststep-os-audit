{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1ststep.ai/os-audit/schemas/0.1.0/audit-target.schema.json",
  "title": "AuditTarget",
  "description": "A project under audit. The profile reuses upstream ProjectProfile field definitions (assessment pattern) so applicability rules are shared with the 1stStep OS module registry. A target need not have been generated by 1stStep OS.",
  "type": "object",
  "required": ["kind", "schemaVersion", "id", "name", "createdAt", "source", "identity", "profile", "environments", "externalSystems"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "AuditTarget" },
    "schemaVersion": { "$ref": "audit-common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "audit-common.schema.json#/$defs/targetId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "createdAt": { "$ref": "audit-common.schema.json#/$defs/timestamp" },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "localPath", "vcs"],
          "properties": {
            "type": { "const": "LOCAL_PATH" },
            "localPath": { "type": "string", "minLength": 1, "maxLength": 1000, "description": "Local-only. Redacted to basename in exported bundles." },
            "vcs": { "enum": ["GIT", "NONE"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "remoteUrl", "ref"],
          "properties": {
            "type": { "const": "GIT_URL" },
            "remoteUrl": { "$ref": "#/$defs/credentialFreeUrl" },
            "ref": { "type": "string", "minLength": 1, "maxLength": 255 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "archiveHash"],
          "properties": {
            "type": { "const": "ARCHIVE_UPLOAD" },
            "archiveHash": { "$ref": "audit-common.schema.json#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      ]
    },
    "identity": {
      "description": "Stable identity across snapshots. STRONG = git root commit(s) known; MODERATE = normalized remote only; WEAK = non-git, identity is the first manifest hash plus user assertion.",
      "type": "object",
      "required": ["strength"],
      "properties": {
        "strength": { "enum": ["STRONG", "MODERATE", "WEAK"] },
        "gitRootCommits": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/gitSha" } },
        "normalizedRemote": { "$ref": "#/$defs/credentialFreeUrl" },
        "firstManifestHash": { "$ref": "audit-common.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "strength": { "const": "STRONG" } } }, "then": { "required": ["gitRootCommits"], "properties": { "gitRootCommits": { "minItems": 1 } } } },
        { "if": { "properties": { "strength": { "const": "WEAK" } } }, "then": { "required": ["firstManifestHash"] } }
      ]
    },
    "profile": {
      "description": "Inferred at discovery, confirmed by the user at audit:G0. Field shapes are upstream ProjectProfile properties.",
      "type": "object",
      "required": ["productTypes", "platformTargets", "dataSensitivity", "auth", "payments", "ai", "businessModel", "integrations", "auditProjectTypes", "confirmation"],
      "properties": {
        "productTypes": { "$ref": "https://1ststep.ai/os/schemas/0.1.0/project-profile.schema.json#/properties/productTypes" },
        "platformTargets": { "$ref": "https://1ststep.ai/os/schemas/0.1.0/project-profile.schema.json#/properties/platformTargets" },
        "lifecycleStage": { "$ref": "https://1ststep.ai/os/schemas/0.1.0/project-profile.schema.json#/properties/lifecycleStage" },
        "dataSensitivity": { "$ref": "https://1ststep.ai/os/schemas/0.1.0/project-profile.schema.json#/properties/dataSensitivity" },
        "auth": { "$ref": "https://1ststep.ai/os/schemas/0.1.0/project-profile.schema.json#/properties/auth" },
        "payments": { "$ref": "https://1ststep.ai/os/schemas/0.1.0/project-profile.schema.json#/properties/payments" },
        "ai": { "$ref": "https://1ststep.ai/os/schemas/0.1.0/project-profile.schema.json#/properties/ai" },
        "businessModel": { "$ref": "https://1ststep.ai/os/schemas/0.1.0/project-profile.schema.json#/properties/businessModel" },
        "integrations": { "$ref": "https://1ststep.ai/os/schemas/0.1.0/project-profile.schema.json#/properties/integrations" },
        "auditProjectTypes": {
          "description": "Derived deterministically from upstream fields by project-types.json derivation rules, then user-confirmed. Multiple types combine by MAX.",
          "$ref": "https://1ststep.ai/os/schemas/0.1.0/common.schema.json#/$defs/assessment",
          "properties": { "value": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "audit-common.schema.json#/$defs/projectTypeId" } } },
          "unevaluatedProperties": false
        },
        "confirmation": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["UNCONFIRMED", "CONFIRMED"] },
            "confirmedBy": { "$ref": "audit-common.schema.json#/$defs/userActor" },
            "confirmedAt": { "$ref": "audit-common.schema.json#/$defs/timestamp" }
          },
          "additionalProperties": false,
          "if": { "properties": { "status": { "const": "CONFIRMED" } } },
          "then": { "required": ["confirmedBy", "confirmedAt"] }
        }
      },
      "additionalProperties": false
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "class", "urls", "declaredBy", "confirmed"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "class": { "enum": ["PRODUCTION", "STAGING", "PREVIEW", "LOCAL"] },
          "urls": { "type": "array", "items": { "$ref": "audit-common.schema.json#/$defs/httpsUrl" } },
          "declaredBy": { "enum": ["USER", "DISCOVERED"] },
          "confirmed": { "type": "boolean", "description": "Only user-confirmed environments may be probed live." }
        },
        "additionalProperties": false
      }
    },
    "externalSystems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "provider", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^SYS-[A-Z0-9-]{2,40}$" },
          "category": { "enum": ["DEPLOYMENT", "AUTH", "DATABASE", "BILLING", "ANALYTICS", "CI_CD", "DNS_DOMAIN", "APP_STORE", "SOCIAL", "AI_PROVIDER", "EMAIL", "STORAGE", "OTHER"] },
          "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
          "environmentClass": { "enum": ["PRODUCTION", "STAGING", "PREVIEW", "LOCAL"] },
          "status": { "enum": ["DISCOVERED_IN_CODE", "DECLARED_BY_USER", "CONNECTED"], "description": "DISCOVERED_IN_CODE is intent only; it says nothing about live state." },
          "connectorId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$" },
    "credentialFreeUrl": {
      "description": "Remote URL with userinfo stripped. Tokens in URLs are rejected.",
      "type": "string", "maxLength": 1000,
      "pattern": "^(https://|ssh://|git@)(?![^/]*:[^/@]*@)[^\\s]+$"
    }
  }
}
